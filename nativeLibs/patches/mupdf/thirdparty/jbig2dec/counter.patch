diff --git a/jbig2_image.c b/jbig2_image.c
index e4a9634..5691cdb 100644
--- a/jbig2_image.c
+++ b/jbig2_image.c
@@ -72,12 +72,15 @@ jbig2_image_new(Jbig2Ctx *ctx, uint32_t width, uint32_t height)
 }
 
 /* bump the reference count for an image pointer */
+/* Glyph images from a shared Jbig2GlobalCtx are referenced/released by
+ * every thread that decodes with these globals, so the refcount must be
+ * atomic to allow concurrent decoding. */
 Jbig2Image *
 jbig2_image_reference(Jbig2Ctx *ctx, Jbig2Image *image)
 {
     (void) ctx;
     if (image)
-        image->refcount++;
+        __atomic_add_fetch(&image->refcount, 1, __ATOMIC_RELAXED);
     return image;
 }
 
@@ -87,8 +90,7 @@ jbig2_image_release(Jbig2Ctx *ctx, Jbig2Image *image)
 {
     if (image == NULL)
         return;
-    image->refcount--;
-    if (image->refcount == 0)
+    if (__atomic_sub_fetch(&image->refcount, 1, __ATOMIC_ACQ_REL) == 0)
         jbig2_image_free(ctx, image);
 }
 
